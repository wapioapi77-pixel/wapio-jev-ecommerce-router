          "value": "YOUR_WAPIO_SESSION_ID",
          "mode": "list",
          "cachedResultName": "Select your connected WhatsApp session"
        },
        "to": "={{ $('Wapio Trigger').first().json.data.messages.key.remoteJid }}",
        "text": "={{ (() => {\n  const trigger = $('Wapio Trigger').first().json;\n  const name = trigger?.data?.messages?.pushName || 'there';\n  const msgObj = trigger?.data?.messages?.message || {};\n  const rawText = (msgObj.conversation || msgObj.extendedTextMessage?.text || trigger?.data?.messages?.messageBody || '').trim();\n  const matchedId = rawText.match(/#?\\d{3,8}\\b/)?.[0] || rawText.match(/\\b\\d{3,8}\\b/)?.[0];\n\n  if (matchedId) {\n    const formattedId = matchedId.startsWith('#') ? matchedId : '#' + matchedId;\n    return '📦 *Order Tracking Request Received*\\n\\nThank you ' + name + '! We have received your inquiry for Order *' + formattedId + '*.\\n\\nOur logistics team is checking the live status with our courier right now and will update you directly in this chat shortly! 🚚';\n  } else {\n    return 'Hi ' + name + '! 📦\\n\\nTo check your order status, please reply with your *Order Number* (e.g. #1042) or your purchase email address.\\n\\nOnce you send it, our team will look up your shipment immediately!';\n  }\n})() }}"
      },
