        "sessionId": {
          "__rl": true,
          "value": "YOUR_WAPIO_SESSION_ID",
          "mode": "list",
          "cachedResultName": "Select your connected WhatsApp session"
        },
        "to": "={{ $('⚙️ Store & Admin Settings').first().json.managerPhone }}",
        "text": "={{ (() => {\n  const trigger = $('Wapio Trigger').first().json;\n  const jev = $('⚡ Jev AI Decision Engine (<300ms)').first().json;\n  const name = trigger?.data?.messages?.pushName || 'Customer';\n  const phone = trigger?.data?.messages?.key?.cleanedSenderPn || trigger?.data?.messages?.key?.remoteJid?.split('@')?.[0] || 'Unknown';\n  const msgObj = trigger?.data?.messages?.message || {};\n  const msg = (msgObj.conversation || msgObj.extendedTextMessage?.text || msgObj.imageMessage?.caption || trigger?.data?.messages?.messageBody || '').trim();\n  const matchedId = msg.match(/#?\\d{3,8}\\b/)?.[0] || msg.match(/\\b\\d{3,8}\\b/)?.[0];\n\n  if (jev.category === 'size_exchange') {\n    return '👕 *SIZE EXCHANGE REQUEST*\\n\\n👤 *Customer:* ' + name + '\\n📱 *Phone:* +' + phone + '\\n💬 *Query:* \"' + msg + '\"\\n📊 *Action:* Dispatched interactive size poll to customer.';\n  }\n  if (jev.category === 'track_order') {\n    const orderStr = matchedId ? (matchedId.startsWith('#') ? matchedId : '#' + matchedId) : (msg || 'Provided in chat');\n    return '📦 *ORDER TRACKING REQUEST*\\n\\n👤 *Customer:* ' + name + '\\n📱 *Phone:* +' + phone + '\\n🔢 *Order ID:* ' + orderStr + '\\n💬 *Query:* \"' + msg + '\"\\n👉 *Action Required:* Look up order ' + orderStr + ' with courier and reply to customer.';\n  }\n  if (jev.category === 'damaged_or_return') {\n    if (jev.is_photo_received) {\n      return '📸 *RETURN PHOTO PROOF RECEIVED*\\n\\n👤 *Customer:* ' + name + '\\n📱 *Phone:* +' + phone + '\\n📸 *Status:* Customer uploaded a damaged item photo on WhatsApp!\\n👉 *Action Required:* Open WhatsApp to review photo and approve replacement/refund.';\n    } else {\n      return '🚨 *URGENT DAMAGED / RETURN REPORT*\\n\\n👤 *Customer:* ' + name + '\\n📱 *Phone:* +' + phone + '\\n⚠️ *Risk Score:* ' + jev.churn_risk_score + '/10\\n💬 *Message:* \"' + msg + '\"\\n👉 *Action Required:* Reassurance sent, waiting for customer photo.';\n    }\n  }\n  return '💬 *NEW STORE INQUIRY*\\n\\n👤 *Customer:* ' + name + '\\n📱 *Phone:* +' + phone + '\\n💬 *Message:* \"' + msg + '\"';\n})() }}"
      },
