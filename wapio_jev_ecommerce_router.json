        "jsonBody": "={\n  \"text\": \"{{ $json.data.messages.message.conversation || $json.data.messages.message.extendedTextMessage.text || $json.data.messages.messageBody || '' }}\",\n  \"categories\": [\"damaged_or_return\", \"size_exchange\", \"track_order\", \"general_inquiry\"],\n  \"extract\": {\n    \"has_order_id\": \"boolean\",\n    \"is_photo_received\": \"boolean\",\n    \"should_notify_manager\": \"boolean\",\n    \"churn_risk_score\": \"number\"\n  }\n}",
